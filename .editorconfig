# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,cpp,h,xaml}]
indent_style = space
indent_size = 4

[*.{csproj,vcxproj,filters,props,targets,xml,resx,settings,config,manifest,ps1,json,yaml,yml}]
indent_style = space
indent_size = 2
